{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:cov": "jest --selectProjects unit --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/unit/**/*.spec.ts"
        ]
      },
      {
        "displayName": "e2e",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/e2e/**/*.e2e-spec.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/e2e/env.ts"
        ],
        "globalSetup": "<rootDir>/test/e2e/global-setup.ts"
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/seed-db.ts",
      "!src/common/seed.ts",
      "!src/**/*.module.ts"
    ],
    "coverageDirectory": "coverage"
  }
}
