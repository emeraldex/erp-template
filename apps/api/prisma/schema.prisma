// ─── Maintenance ERP — PostgreSQL persistence (CO-RFP-IT-001) ─────────────────────
// Models the actual QP domain: PS-numbered jobs (QP.44), spares demands (QP.14),
// outside-vendor repairs (QP.33), supplier/sub-contractor registers (QP.13/34),
// FOD & tool accountability (QP.46), and invoicing streams (QP.51).
//
// Audit entries and Section 6 form records are first-class append-only tables so
// FR-04 (audit trail) and FR-12 (5-year retention) are queryable, not buried in
// JSON blobs. Workflow rules (transitions, SLA timers, invoice streams) are rows
// too, so FR-02 runtime rule changes survive a restart.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enumerations: only generic lifecycles stay as database enums ────────────
// Statuses, roles, sites, locations, categories, streams, priority levels,
// routes, incident areas and courses are per-organisation dictionary data
// (dictionary_entries), so any maintenance sector can define its own.

enum PartnerType {
  SUPPLIER
  SUBCONTRACTOR
}

enum PartnerStatus {
  APPLIED
  UNDER_EVALUATION
  JTP_APPROVED
  REGISTERED
  DROPPED
}

enum PriorityState {
  OPEN
  CLOSED
}

enum PriorityCloseReason {
  DELIVERED
  DOWNGRADED
}

enum FodStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum ToolStatus {
  IN
  OUT
  MISSING
}

enum SlaEntity {
  JOB
  DEMAND
  OV
  INVOICE
}

enum WorkflowKind {
  JOB
  DEMAND
  OV
  INVOICE
}

// ─── Actors ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String
  role         String
  designation  String
  branch       String
  createdAt    DateTime @default(now())

  // Account protection (Phase 1 hardening)
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean        @default(false)
  passwordChangedAt  DateTime?
  /// Set when an administrator deactivates the account; history stays attributed.
  deactivatedAt      DateTime?
  /// Labour: this person's cost per hour (else their role's, else the organisation's).
  hourlyRate         Decimal?       @db.Decimal(14, 4)
  sessions           Session[]
  notifications      Notification[]

  @@map("users")
}

/// Server-side login session. The signed token only carries the session id, so
/// signing out, a password change or an admin can revoke access immediately.
model Session {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  /// "password" or "sso" — SSO users are not asked to change a password they don't use.
  method     String    @default("password")

  @@index([userId])
  @@map("sessions")
}

// ─── QP.44 job lifecycle (FR-01) ──────────────────────────────────────────────

model Job {
  id           String    @id
  psDate       String
  component    String
  partNo       String
  serialNo     String
  category     String
  originUnit   String
  repairUnit   String
  status       String
  location     String
  receivedAt   DateTime
  statusSince  DateTime
  indentRef    String?
  ovId         String?
  /// Corrective, preventive, inspection… (jobType dictionary).
  jobType      String    @default("CORRECTIVE")
  /// The asset worked on, when it is in the asset register.
  assetId      String?
  asset        Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  /// Set when a preventive-maintenance schedule raised the job.
  pmScheduleId String?
  /// When the preventive cycle that raised it was due.
  pmDueAt      DateTime?
  /// When it last entered a done phase.
  doneAt       DateTime?
  /// The asset was out of action when the work was raised.
  assetDown    Boolean   @default(false)
  /// Checklist items: [{ key, label, required, done, by, at, note }].
  checklist    Json      @default("[]")
  /// The person the work is assigned to (users are never deleted, so no foreign key).
  assigneeId   String?
  assigneeName String?
  assignedAt   DateTime?
  /// FR-12: set when a long-closed job leaves the active lists. Read-only after.
  archivedAt   DateTime?
  // Optimistic-concurrency guard: a transition that reads v=n writes v=n+1 and
  // fails if another actor already advanced the row (two Stores clerks
  // dispatching the same PS number must not silently overwrite each other).
  version      Int       @default(0)
  ordinal      Int       @default(0)

  priority JobPriority?
  demands  Demand[]
  ov       OvRepair[]
  invoices Invoice[]
  records  FormRecord[]
  audit    AuditEntry[]

  @@index([status])
  @@index([status, statusSince])
  @@index([repairUnit])
  @@index([ordinal])
  @@index([archivedAt])
  @@index([assetId])
  @@index([assigneeId])
  @@map("jobs")
}

/// Anything maintained: a chiller, a van, a pump, an infusion pump, a building.
model Asset {
  id             String   @id
  /// The organisation's own tag, registration or asset number.
  tag            String   @unique
  name           String
  /// assetType dictionary key.
  type           String
  /// site dictionary key.
  site           String
  /// Where on the site: room, bay, line…
  location       String   @default("")
  parentId       String?
  parent         Asset?   @relation("AssetTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Asset[]  @relation("AssetTree")
  make           String   @default("")
  model          String   @default("")
  serialNo       String   @default("")
  /// IN_SERVICE, OUT_OF_SERVICE or RETIRED.
  status         String   @default("IN_SERVICE")
  /// HIGH, MEDIUM or LOW: how much its failure matters.
  criticality    String   @default("MEDIUM")
  commissionedOn String?
  /// Sector-specific details (e.g. VIN, refrigerant, device class).
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now())
  createdBy      String   @default("")
  ordinal        Int      @default(0)
  version        Int      @default(0)

  meters    Meter[]
  schedules PmSchedule[]
  jobs      Job[]

  @@index([site])
  @@index([type])
  @@index([parentId])
  @@map("assets")
}

/// A running counter on an asset: odometer, engine or run hours, cycles…
model Meter {
  id       Int            @id @default(autoincrement())
  assetId  String
  asset    Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  key      String
  label    String
  unit     String
  value    Float          @default(0)
  readAt   DateTime?
  readings MeterReading[]

  @@unique([assetId, key])
  @@map("meters")
}

model MeterReading {
  id      BigInt   @id @default(autoincrement())
  meterId Int
  meter   Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  value   Float
  at      DateTime @default(now())
  by      String
  /// "manual", "job:<id>" or "reset".
  source  String   @default("manual")

  @@index([meterId, at])
  @@map("meter_readings")
}

/// Preventive maintenance: raise a job every N days and/or every N meter units.
model PmSchedule {
  id            String    @id
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  active        Boolean   @default(true)
  intervalDays  Int?
  meterKey      String?
  intervalMeter Float?
  /// Raise the job this many days before it falls due…
  leadDays      Int       @default(7)
  /// …or this many meter units before.
  leadMeter     Float     @default(0)
  jobType       String    @default("PREVENTIVE")
  category      String    @default("")
  instructions  String    @default("")
  /// [{ key, label, required }]
  checklist     Json      @default("[]")
  lastDoneAt    DateTime?
  lastDoneMeter Float?
  nextDueAt     DateTime?
  nextDueMeter  Float?
  /// The job raised for the current cycle, until it is done.
  openJobId     String?
  createdAt     DateTime  @default(now())
  createdBy     String    @default("")

  @@index([active])
  @@index([assetId])
  @@map("pm_schedules")
}

// QP.56 AOG / ROA / Critical overlay (5.9) — FR-15
model JobPriority {
  id          String               @id @default(cuid())
  job         Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String               @unique
  type        String
  quantity    Int                  @default(1)
  route       String
  suffixK     Boolean              @default(false)
  state       PriorityState        @default(OPEN)
  colRef      String
  raisedAt    DateTime
  raisedBy    String
  edd         String?
  remark      String?
  closedAt    DateTime?
  closeReason PriorityCloseReason?

  audit AuditEntry[]

  @@index([state])
  @@map("job_priorities")
}

// ─── QP.14 spares demand / procurement (FR-08) ────────────────────────────────

model Demand {
  id              String   @id
  /// The work order the part is for; empty for a purchase request for stock.
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  jobId           String?
  partDescription String
  partNo          String
  qty             Decimal  @db.Decimal(14, 3)
  /// The catalogue part, when the request is for one (stock moves only then).
  partId          String?
  /// For a purchase request for stock: the store it replenishes.
  forStore        String?
  /// Unit cost at receipt.
  unitCost        Decimal? @db.Decimal(14, 4)
  status          String
  statusSince     DateTime
  raisedBy        String
  branch          String
  version         Int      @default(0)
  ordinal         Int      @default(0)

  // stockCheck (F244)
  stockF244Ref      String?
  stockAvailable    Boolean?
  stockHoldingUnit  String?
  // RFQ (F220)
  rfqRef            String?
  // evaluation (F221 / local purchase F241)
  evalF221Ref       String?
  evalSupplierId    String?
  evalLocalPurchase Boolean?
  evalF241Ref       String?
  // purchase order (F312)
  poRef             String?
  // receiving discrepancy (F217)
  discF217Ref       String?
  discNote          String?

  quotations Quotation[]
  records    FormRecord[]
  audit      AuditEntry[]

  @@index([status])
  @@index([status, statusSince])
  @@index([jobId])
  @@index([ordinal])
  @@map("demands")
}

model Quotation {
  id         Int     @id @default(autoincrement())
  demand     Demand  @relation(fields: [demandId], references: [id], onDelete: Cascade)
  demandId   String
  supplierId String
  supplier   String
  priceMYR   Decimal @db.Decimal(14, 2)
  eddDays    Int
  remarks    String?
  seq        Int

  @@unique([demandId, seq])
  @@map("quotations")
}

// ─── QP.33 outside-vendor repair (FR-09) ──────────────────────────────────────

model OvRepair {
  id              String   @id
  job             Job      @relation(fields: [jobId], references: [id])
  jobId           String
  defectReportRef String
  am75Ref         String
  vendorId        String?
  vendorName      String?
  f134Ref         String?
  poRef           String?
  costMYR         Decimal? @db.Decimal(14, 2)
  eddDays         Int?
  aboveIndent     Boolean?
  f119Ref         String?
  status          String
  statusSince     DateTime
  version         Int      @default(0)
  ordinal         Int      @default(0)

  records FormRecord[]
  audit   AuditEntry[]

  @@index([status])
  @@index([status, statusSince])
  @@index([ordinal])
  @@map("ov_repairs")
}

// ─── QP.13 / QP.34 supplier & sub-contractor registers (FR-07) ────────────────

model Partner {
  id               String        @id
  name             String
  type             PartnerType
  status           PartnerStatus
  country          String
  certifications   String[]
  lists            String[]
  rating           Int?
  evaluationRef    String?
  siteAuditRef     String?
  lastAssessed     String?
  nextReassessment String?
  nonConformances  Int           @default(0)
  factorsEvaluated Int           @default(0)
  version          Int           @default(0)
  ordinal          Int           @default(0)

  cars  Car[]
  audit AuditEntry[]

  @@index([status])
  @@index([type])
  @@index([ordinal])
  @@map("partners")
}

model Car {
  id        Int     @id @default(autoincrement())
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String
  ref       String
  date      String
  reason    String
  seq       Int

  @@unique([partnerId, seq])
  @@map("cars")
}

// ─── QP.46 FOD, tool accountability & training (FR-11) ────────────────────────

model FodIncident {
  id               String    @id
  date             String
  partName         String
  typeModel        String
  serialNo         String
  area             String
  location         String
  discovered       String
  rootCause        String?
  correctiveAction String?
  reporter         String
  focalPoint       String
  status           FodStatus
  version          Int       @default(0)
  ordinal          Int       @default(0)

  audit AuditEntry[]

  @@index([status])
  @@index([ordinal])
  @@map("fod_incidents")
}

model Tool {
  tag     String     @id
  name    String
  board   String
  holder  String?
  status  ToolStatus
  since   DateTime
  ordinal Int        @default(0)

  @@index([status])
  @@index([ordinal])
  @@map("tools")
}

model TrainingRecord {
  id      Int    @id @default(autoincrement())
  person  String
  course  String
  date    String
  nextDue String
  ordinal Int    @default(0)

  @@unique([person, course])
  @@index([ordinal])
  @@map("training_records")
}

// ─── QP.51 invoicing & revenue billing (FR-13 / FR-14) ────────────────────────

model Invoice {
  id              String   @id
  stream          String
  job             Job?     @relation(fields: [jobId], references: [id])
  jobId           String?
  customer        String
  period          String?
  amountMYR       Decimal  @db.Decimal(14, 2)
  gstRate         Decimal  @db.Decimal(5, 2)
  /// Tax name printed on documents (GST, SST…), fixed when the invoice is drafted.
  taxLabel        String   @default("GST")
  gstMYR          Decimal  @db.Decimal(14, 2)
  totalMYR        Decimal  @db.Decimal(14, 2)
  status          String
  statusSince     DateTime
  f311Ref         String?
  ctcRef          String?
  customerSignRef String?
  correctnessBy   String?
  salesPerfRef    String?
  paymentRef      String?
  paidAt          String?
  outstanding     Boolean  @default(true)
  raisedBy        String
  branch          String
  version         Int      @default(0)
  ordinal         Int      @default(0)

  records FormRecord[]
  audit   AuditEntry[]

  @@index([status])
  @@index([status, statusSince])
  @@index([outstanding])
  @@index([ordinal])
  @@map("invoices")
}

// ─── Cross-cutting: audit trail (FR-04) & Section 6 forms register (FR-05) ────
// Append-only. Nullable parent FKs rather than one table per parent: Prisma has
// no polymorphic relations, and a single trail keeps "who touched what, when"
// answerable in one query for the 5-year retention posture (FR-12).

model AuditEntry {
  id     BigInt   @id @default(autoincrement())
  at     DateTime
  by     String
  role   String
  action String
  fields Json?
  seq    Int

  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String?
  jobPriority   JobPriority? @relation(fields: [jobPriorityId], references: [id], onDelete: Cascade)
  jobPriorityId String?
  demand        Demand?      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  demandId      String?
  ov            OvRepair?    @relation(fields: [ovId], references: [id], onDelete: Cascade)
  ovId          String?
  partner       Partner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId     String?
  fod           FodIncident? @relation(fields: [fodId], references: [id], onDelete: Cascade)
  fodId         String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String?

  @@index([jobId, seq])
  @@index([jobPriorityId, seq])
  @@index([demandId, seq])
  @@index([ovId, seq])
  @@index([partnerId, seq])
  @@index([fodId, seq])
  @@index([invoiceId, seq])
  @@index([at])
  @@map("audit_entries")
}

model FormRecord {
  id     BigInt  @id @default(autoincrement())
  formNo String
  refNo  String
  date   String
  by     String
  note   String?
  seq    Int

  job       Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  demand    Demand?   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  demandId  String?
  ov        OvRepair? @relation(fields: [ovId], references: [id], onDelete: Cascade)
  ovId      String?
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String?

  @@index([jobId, seq])
  @@index([demandId, seq])
  @@index([ovId, seq])
  @@index([invoiceId, seq])
  @@index([formNo])
  @@map("form_records")
}

// ─── Workflow-as-data (FR-02) ─────────────────────────────────────────────────
// Persisted so a runtime rule change (PATCH /config/sla/:id) survives a restart.

model TransitionRuleRow {
  id          Int          @id @default(autoincrement())
  kind        WorkflowKind
  from        String
  to          String
  label       String
  labelMs     String
  roles       String[]
  requires    Json
  setLocation String?
  /// Actions run when the step is taken (raise a demand, mark paid…): [{type, params}]
  effects     Json         @default("[]")
  seq         Int

  @@unique([kind, from, to])
  @@index([kind, seq])
  @@map("transition_rules")
}

model SlaRule {
  id     String    @id
  entity SlaEntity
  status String
  days   Int
  rule   String
  source String
  seq    Int

  @@index([entity])
  @@map("sla_rules")
}

model InvoiceStreamDef {
  id             String   @id
  label          String
  labelMs        String
  customer       String
  perJob         Boolean
  docSet         String[]
  deadlines      Json
  /// Extra fields this stream needs before a status, e.g. {"SUBMITTED": ["salesPerfRef"]}
  requiredFields Json     @default("{}")
  seq            Int

  @@map("invoice_streams")
}

model WeeklyClosure {
  week  Int @id
  count Int

  @@map("weekly_closures")
}

// ─── Phase 2: settings, attachments, notifications ───────────────────────────

/// Organisation-level settings edited by ADMIN (company profile, tax).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("settings")
}

/// A file attached to a record (signed forms, certificates, photos). The bytes
/// live in object storage; the SHA-256 lets anyone verify they are unchanged.
model Attachment {
  id          String   @id
  entity      String
  entityId    String
  formNo      String?
  filename    String
  contentType String
  sizeBytes   Int
  sha256      String
  storageKey  String   @unique
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  /// file, photo or signature.
  kind        String   @default("file")
  caption     String?
  /// For signatures: the name of the person who signed.
  signedBy    String?

  @@index([entity, entityId])
  @@map("attachments")
}

/// One in-app message for one user (SLA alerts today).
model Notification {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  ref       String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
  @@map("notifications")
}

/// Records that an SLA alert went out, so each (record, rule, level) is sent once.
model SlaAlert {
  id     String   @id
  ref    String
  ruleId String
  level  String
  sentAt DateTime @default(now())

  @@unique([ref, ruleId, level])
  @@map("sla_alerts")
}

/// Change control for workflow configuration (who changed which rules, before/after).
model ConfigChange {
  id      String   @id
  at      DateTime @default(now())
  by      String
  role    String
  area    String
  summary String
  before  Json
  after   Json

  @@index([at])
  @@map("config_changes")
}

/// Per-organisation vocabulary: statuses of each workflow, roles (with their
/// capabilities), sites, locations, categories, priority levels, routes,
/// incident areas, training courses, asset types… One row per entry.
model DictionaryEntry {
  id      Int     @id @default(autoincrement())
  kind    String
  key     String
  label   String
  labelMs String  @default("")
  meta    Json    @default("{}")
  seq     Int     @default(0)
  active  Boolean @default(true)

  @@unique([kind, key])
  @@index([kind, seq])
  @@map("dictionary_entries")
}

/// Offline changes replayed from a phone, so a resent change is applied once.
model ClientOp {
  /// The phone's own id for the change.
  id        String   @id
  userId    String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("client_ops")
}

/// A part the organisation stocks (its own part number is the key people use).
model Part {
  id                  String   @id
  partNo              String   @unique
  name                String
  description         String   @default("")
  /// unit dictionary key (EA, SET, L…).
  unit                String   @default("EA")
  /// partGroup dictionary key.
  group               String   @default("")
  manufacturer        String   @default("")
  mfrPartNo           String   @default("")
  preferredSupplierId String?
  /// Moving average cost across all stores.
  avgCost             Decimal  @default(0) @db.Decimal(14, 4)
  lastCost            Decimal? @db.Decimal(14, 4)
  active              Boolean  @default(true)
  attributes          Json     @default("{}")
  createdAt           DateTime @default(now())
  createdBy           String   @default("")
  version             Int      @default(0)

  levels    StockLevel[]
  movements StockMovement[]

  @@index([group])
  @@index([name])
  @@map("parts")
}

/// How much of a part one store holds, where, and when to reorder.
model StockLevel {
  id           Int       @id @default(autoincrement())
  partId       String
  part         Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  /// store dictionary key.
  store        String
  bin          String    @default("")
  qty          Decimal   @default(0) @db.Decimal(14, 3)
  reorderPoint Decimal?  @db.Decimal(14, 3)
  reorderQty   Decimal?  @db.Decimal(14, 3)
  /// Set when the quantity fell to the reorder point (one alert per crossing).
  lowSince     DateTime?
  countedAt    DateTime?

  @@unique([partId, store])
  @@index([store])
  @@map("stock_levels")
}

/// The stock ledger: append-only. Corrections are new movements.
model StockMovement {
  id           BigInt   @id @default(autoincrement())
  partId       String
  part         Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  store        String
  /// OPENING, RECEIPT, ISSUE, RETURN, ADJUST, COUNT, TRANSFER_OUT, TRANSFER_IN.
  type         String
  /// Signed: positive into the store, negative out of it.
  qty          Decimal  @db.Decimal(14, 3)
  unitCost     Decimal  @db.Decimal(14, 4)
  balanceAfter Decimal  @db.Decimal(14, 3)
  jobId        String?
  demandId     String?
  countId      String?
  transferRef  String?
  reason       String   @default("")
  by           String
  at           DateTime @default(now())

  @@index([partId, at])
  @@index([jobId])
  @@index([store, at])
  @@map("stock_movements")
}

/// Counting a store: quantities entered against a snapshot, differences posted.
model StockCount {
  id        String           @id
  store     String
  /// OPEN, POSTED or CANCELLED.
  status    String           @default("OPEN")
  startedBy String
  startedAt DateTime         @default(now())
  postedBy  String?
  postedAt  DateTime?
  note      String           @default("")
  lines     StockCountLine[]

  @@index([store, status])
  @@map("stock_counts")
}

model StockCountLine {
  id         Int        @id @default(autoincrement())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  partId     String
  systemQty  Decimal    @db.Decimal(14, 3)
  countedQty Decimal?   @db.Decimal(14, 3)

  @@unique([countId, partId])
  @@map("stock_count_lines")
}

/// A problem reported through the public request portal (or logged by staff for a caller).
model ServiceRequest {
  id             String           @id
  /// NEW, ACCEPTED, DECLINED or CANCELLED.
  status         String           @default("NEW")
  description    String
  /// Where, in the requester's words (e.g. "Level 3, east toilets").
  place          String           @default("")
  site           String           @default("")
  assetId        String?
  /// The QR poster it came from, if any.
  pointCode      String?
  category       String           @default("")
  urgent         Boolean          @default(false)
  requesterName  String
  requesterEmail String           @default("")
  requesterPhone String           @default("")
  /// en or ms: the language of emails and the tracking page.
  lang           String           @default("en")
  /// PORTAL, POSTER or STAFF.
  source         String           @default("PORTAL")
  /// Part of the tracking link's signature; changing it cancels old links.
  trackSalt      String
  jobId          String?
  /// Added to an existing work order rather than starting a new one.
  merged         Boolean          @default(false)
  decidedBy      String?
  decidedAt      DateTime?
  declineReason  String           @default("")
  spam           Boolean          @default(false)
  rating         Int?
  ratingComment  String           @default("")
  ratedAt        DateTime?
  remindedAt     DateTime?
  doneNotifiedAt DateTime?
  /// Keyed hash of the sender's address, for spotting abuse (never the address itself).
  ipHash         String           @default("")
  createdAt      DateTime         @default(now())
  version        Int              @default(0)
  messages       RequestMessage[]

  @@index([status])
  @@index([jobId])
  @@index([createdAt])
  @@map("service_requests")
}

/// A message on a request, from the team or from the requester.
model RequestMessage {
  id        Int            @id @default(autoincrement())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// TEAM or REQUESTER.
  from      String
  by        String
  body      String
  at        DateTime       @default(now())

  @@index([requestId])
  @@map("request_messages")
}

/// A "Report a problem" QR poster or sticker for a place or an asset.
model RequestPoint {
  /// Random and unguessable; the QR carries it.
  code      String   @id
  label     String
  site      String   @default("")
  assetId   String?
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())

  @@index([assetId])
  @@map("request_points")
}

/// Time someone spent on a work order. The rate in force when it was logged
/// stays with it, so later rate changes never rewrite labour cost.
model TimeEntry {
  id        String   @id
  jobId     String
  userId    String
  userName  String
  workDate  DateTime @db.Date
  minutes   Int
  note      String   @default("")
  /// Cost per hour when logged; null when no rate was set.
  rate      Decimal? @db.Decimal(14, 4)
  cost      Decimal  @default(0) @db.Decimal(14, 2)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([userId, workDate])
  @@index([workDate])
  @@map("time_entries")
}

/// A spell when an asset was out of action: opened when work says so or the
/// asset is put out of service, closed when the work is done or it is back.
model AssetDowntime {
  id       Int       @id @default(autoincrement())
  assetId  String
  fromAt   DateTime
  toAt     DateTime?
  jobId    String?
  reason   String    @default("")
  openedBy String
  closedBy String?

  @@index([assetId, fromAt])
  @@index([jobId])
  @@map("asset_downtime")
}
