# Copy to .env.prod and fill in. Never commit the real file.
#   cp .env.prod.example .env.prod
#   AUTH_SECRET:       openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 24
#
# Use hex, not base64, for POSTGRES_PASSWORD. Compose interpolates it into
# DATABASE_URL (postgresql://user:PASS@db:5432/...), where base64's '/', '+'
# and '=' are reserved characters — they would have to be percent-encoded, and
# unencoded they silently truncate or corrupt the connection URL. Whether it
# breaks depends on which characters openssl happens to emit, so it fails
# intermittently and looks like an auth bug. Hex is URL-safe by construction.

# ─── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp

# ─── api ─────────────────────────────────────────────────────────────────────
# Must not be left as the placeholder — the API refuses to start without it.
AUTH_SECRET=
AUTH_TTL_HOURS=8
AUTH_IDLE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
# Number of reverse-proxy hops in front of the API (for real client IPs).
TRUST_PROXY=1
# Keep true behind HTTPS. Set false only for a plain-HTTP local trial.
COOKIE_SECURE=true
# Browser origin allowed by CORS. A single concrete origin in production.
WEB_ORIGIN=http://localhost:3000
PG_POOL_MAX=10

# ─── web ─────────────────────────────────────────────────────────────────────
# Inlined into the browser bundle at BUILD time — rebuild the web image if this
# changes. Must be the URL a browser can reach (not the internal 'api' host).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# 1 = show bundled sample data when the API is down. Sales demos only.
NEXT_PUBLIC_DEMO_MODE=0

# ─── seeding ─────────────────────────────────────────────────────────────────
# 1 loads the reference dataset into an empty DB; no-ops once users exist.
RUN_SEED=1
# Overrides the demo password for every seeded account. Set this, or change the
# passwords immediately after first boot.
SEED_PASSWORD=
# Seeded users must choose a new password at first sign-in. 0 for demos only.
SEED_FORCE_PASSWORD_CHANGE=1

# ─── backups ─────────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Host directory the dumps are written to. Copy it off the server regularly.
BACKUP_HOST_DIR=./backups

# ─── exposure ────────────────────────────────────────────────────────────────
# Bind to loopback by default; put a TLS-terminating reverse proxy in front.
# Set to 0.0.0.0 only if the host is firewalled appropriately.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
