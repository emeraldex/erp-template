# Local development. For the container stack see .env.prod.example.

# ---- apps/api ----
PORT=4000
# Required. The API refuses to start if this is unset or left at the
# placeholder below. Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-in-production
AUTH_TTL_HOURS=8
# Required — there is no in-memory fallback.
DATABASE_URL=postgresql://brand:brand@localhost:5432/erp
PG_POOL_MAX=10
# Browser origin allowed by CORS; omit to reflect the request origin (dev only).
WEB_ORIGIN=http://localhost:3000

# ---- seeding ----
# Overrides the reference dataset's demo password for every seeded account.
SEED_PASSWORD=

# ---- apps/web ----
# Inlined into the browser bundle at BUILD time — rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
