# Local development. For the container stack see .env.prod.example.

# ---- apps/api ----
PORT=4000
# Required. The API refuses to start if this is unset or left at the
# placeholder below. Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-in-production
# Absolute session length, and sign-out after this long without activity.
AUTH_TTL_HOURS=8
AUTH_IDLE_MINUTES=60
# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_ATTEMPTS failures.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Requests per client IP per minute: sign-in, and everything else.
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
# Required — there is no in-memory fallback.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp
PG_POOL_MAX=10
# Browser origin allowed by CORS; omit to reflect the request origin (dev only).
WEB_ORIGIN=http://localhost:3000

# ---- seeding ----
# Overrides the reference dataset's demo password for every seeded account.
SEED_PASSWORD=
# 1 = seeded users must change their password at first sign-in (default in production).
SEED_FORCE_PASSWORD_CHANGE=

# ---- apps/web ----
# Inlined into the browser bundle at BUILD time — rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# 1 = when the API is unreachable, show bundled sample data (demos only).
NEXT_PUBLIC_DEMO_MODE=0

# ---- attachments ----
# local (files under ATTACHMENTS_DIR) or s3 (any S3-compatible bucket).
STORAGE_DRIVER=local
ATTACHMENTS_DIR=./data/attachments
ATTACHMENT_MAX_MB=20
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=            # e.g. http://localhost:9000 for MinIO
# S3_FORCE_PATH_STYLE=    # true for MinIO
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=

# ---- alerts, email, archiving ----
SCHEDULER_ENABLED=true
ALERT_INTERVAL_MINUTES=15
SLA_WARN_DAYS=1
# Email digests; leave empty to deliver alerts in the app only.
SMTP_URL=
MAIL_FROM=Maintenance ERP <no-reply@example.com>
ARCHIVE_AFTER_DAYS=365
ARCHIVE_INTERVAL_HOURS=24
RETENTION_YEARS=5
